NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only: NEVER prefix these with NEXT_PUBLIC_
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_OUTPUT_TOKENS=2400
# Never put SUPABASE_SERVICE_ROLE_KEY in client code.

# V8 adaptive learning
ADAPTIVE_MASTERED_THRESHOLD=0.8
ADAPTIVE_REVIEW_THRESHOLD=0.6
